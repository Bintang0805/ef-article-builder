---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout>
  <!-- Hero Section -->
  <section
    class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-purple-50 via-blue-50 to-pink-50 animated-gradient overflow-hidden"
  >
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div
            class="inline-flex items-center space-x-2 bg-purple-100 text-purple-700 px-4 py-2 rounded-full text-sm font-semibold"
          >
            <i class="fas fa-sparkles"></i>
            <span>JavaScript Library Terbaru</span>
          </div>
          <h1 class="text-5xl lg:text-6xl font-bold leading-tight">
            Builder Artikel <span
              class="bg-gradient-to-r from-purple-600 to-blue-500 bg-clip-text text-transparent"
              >Modern & Powerful</span
            >
          </h1>
          <p class="text-xl text-gray-600 leading-relaxed">
            Buat konten artikel yang menakjubkan dengan drag-and-drop builder
            yang mudah digunakan. Dilengkapi dengan 40+ komponen premium yang
            siap pakai.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="#pricing"
              class="group px-8 py-4 bg-gradient-to-r from-purple-600 to-blue-500 text-white rounded-full font-semibold hover:shadow-2xl hover:scale-105 transition-all duration-300 flex items-center space-x-2"
            >
              <span>Mulai Gratis</span>
              <i
                class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"
              ></i>
            </a>
            <a
              href="#demo"
              class="px-8 py-4 bg-white text-purple-600 rounded-full font-semibold hover:shadow-lg border-2 border-purple-200 hover:border-purple-400 transition-all duration-300 flex items-center space-x-2"
            >
              <i class="fas fa-play"></i>
              <span>Lihat Demo</span>
            </a>
          </div>
          <div class="flex items-center space-x-8 text-sm text-gray-600">
            <div class="flex items-center space-x-2">
              <i class="fas fa-check-circle text-green-500"></i>
              <span>Gratis untuk personal</span>
            </div>
            <div class="flex items-center space-x-2">
              <i class="fas fa-check-circle text-green-500"></i>
              <span>Tanpa kartu kredit</span>
            </div>
          </div>
        </div>
        <div class="relative float-animation">
          <div
            class="absolute -top-10 -right-10 w-72 h-72 bg-purple-300 rounded-full mix-blend-multiply filter blur-xl opacity-70"
          >
          </div>
          <div
            class="absolute -bottom-10 -left-10 w-72 h-72 bg-blue-300 rounded-full mix-blend-multiply filter blur-xl opacity-70"
          >
          </div>
          <div
            class="relative bg-white rounded-2xl shadow-2xl p-6 border border-gray-100"
          >
            <div class="flex items-center space-x-2 mb-4">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <div class="space-y-3">
              <div
                class="h-8 bg-gradient-to-r from-purple-100 to-blue-100 rounded-lg"
              >
              </div>
              <div class="grid grid-cols-3 gap-3">
                <div
                  class="h-24 bg-purple-50 rounded-lg flex items-center justify-center"
                >
                  <i class="fas fa-heading text-purple-400 text-2xl"></i>
                </div>
                <div
                  class="h-24 bg-blue-50 rounded-lg flex items-center justify-center"
                >
                  <i class="fas fa-image text-blue-400 text-2xl"></i>
                </div>
                <div
                  class="h-24 bg-pink-50 rounded-lg flex items-center justify-center"
                >
                  <i class="fas fa-video text-pink-400 text-2xl"></i>
                </div>
              </div>
              <div class="h-6 bg-gray-100 rounded w-3/4"></div>
              <div class="h-6 bg-gray-100 rounded w-full"></div>
              <div class="h-6 bg-gray-100 rounded w-2/3"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl lg:text-5xl font-bold mb-4">Fitur Unggulan</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Semua yang Anda butuhkan untuk membuat konten artikel yang profesional
          dan menarik
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div
          class="group p-8 rounded-2xl bg-gradient-to-br from-purple-50 to-purple-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-purple-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
          >
            <i class="fas fa-hand-pointer text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3">Drag & Drop</h3>
          <p class="text-gray-600">
            Susun konten dengan mudah menggunakan antarmuka drag-and-drop yang
            intuitif
          </p>
        </div>

        <!-- Feature 2 -->
        <div
          class="group p-8 rounded-2xl bg-gradient-to-br from-blue-50 to-blue-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-blue-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
          >
            <i class="fas fa-cubes text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3">40+ Komponen</h3>
          <p class="text-gray-600">
            Tip blocks, cards, timeline, accordion, polls, dan banyak
            lagi
          </p>
        </div>

        <!-- Feature 3 -->
        <div
          class="group p-8 rounded-2xl bg-gradient-to-br from-pink-50 to-pink-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-pink-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
          >
            <i class="fas fa-palette text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3">Multiple Themes</h3>
          <p class="text-gray-600">
            Pilih dari berbagai tema siap pakai atau buat tema kustom Anda
            sendiri
          </p>
        </div>

        <!-- Feature 4 -->
        <div
          class="group p-8 rounded-2xl bg-gradient-to-br from-green-50 to-green-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-green-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
          >
            <i class="fas fa-eye text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3">Live Preview</h3>
          <p class="text-gray-600">
            Lihat hasil akhir artikel Anda secara real-time saat mengedit
          </p>
        </div>

        <!-- Feature 5 -->
        <div
          class="group p-8 rounded-2xl bg-gradient-to-br from-yellow-50 to-yellow-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-yellow-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
          >
            <i class="fas fa-code text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3">Export HTML/JSON</h3>
          <p class="text-gray-600">
            Export konten Anda dalam format HTML atau JSON dengan mudah
          </p>
        </div>

        <!-- Feature 6 -->
        <div
          class="group p-8 rounded-2xl bg-gradient-to-br from-indigo-50 to-indigo-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-indigo-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
          >
            <i class="fas fa-mobile-alt text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3">Responsive</h3>
          <p class="text-gray-600">
            Tampilan sempurna di semua perangkat, dari desktop hingga mobile
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo Section -->
  <section
    id="demo"
    class="py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-gray-50 to-gray-100"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl lg:text-5xl font-bold mb-4">Lihat dalam Aksi</h2>
        <p class="text-xl text-gray-600">
          Coba sendiri kemudahan EF Article Builder - Langsung di browser Anda!
        </p>
      </div>
      <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
        <div
          class="bg-gradient-to-r from-purple-600 to-blue-500 p-6 text-white"
        >
          <div
            class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4"
          >
            <div class="flex items-center space-x-4">
              <i class="fas fa-code text-2xl"></i>
              <div>
                <h3 class="font-bold text-lg">Interactive Demo</h3>
                <p class="text-sm text-purple-100">
                  Drag komponen dari sidebar, edit konten, dan lihat hasilnya
                  secara real-time
                </p>
              </div>
            </div>
            <div class="flex gap-2">
              <a
                href="#get-started"
                class="px-6 py-2 bg-white text-purple-600 rounded-lg font-semibold hover:shadow-lg transition-all text-sm"
              >
                Dapatkan Sekarang
              </a>
            </div>
          </div>
        </div>
        <div class="p-6">
          <!-- EF Article Builder Container -->
          <div id="demo-editor" data-name="demo_content"></div>
        </div>
        <div class="p-6 bg-gray-50 border-t border-gray-200">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-600">
              <i class="fas fa-info-circle text-blue-500"></i>
              <span class="ml-2"
                >Ini adalah versi gratis dengan 15 komponen dasar. Upgrade ke
                Pro untuk mendapatkan 40+ komponen premium!</span
              >
            </div>
            <a
              href="#pricing"
              class="text-purple-600 hover:text-purple-700 font-semibold text-sm"
            >
              Lihat Harga <i class="fas fa-arrow-right ml-1"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl lg:text-5xl font-bold mb-4">Pilih Paket Anda</h2>
        <p class="text-xl text-gray-600">Mulai gratis, upgrade kapan saja</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <!-- Free Plan -->
        <div
          class="rounded-3xl p-8 border-2 border-gray-200 hover:border-purple-300 transition-all hover:shadow-lg"
        >
          <div class="mb-6">
            <h3 class="text-2xl font-bold mb-2">Gratis</h3>
            <p class="text-gray-600">Untuk penggunaan personal</p>
          </div>
          <div class="mb-6">
            <span class="text-5xl font-bold">Rp 0</span>
            <span class="text-gray-600">/selamanya</span>
          </div>
          <ul class="space-y-4 mb-8">
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-green-500 mt-1"></i>
              <span class="text-gray-600">15 Komponen dasar</span>
            </li>
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-green-500 mt-1"></i>
              <span class="text-gray-600">3 Tema siap pakai</span>
            </li>
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-green-500 mt-1"></i>
              <span class="text-gray-600">Export HTML/JSON</span>
            </li>
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-green-500 mt-1"></i>
              <span class="text-gray-600">Dokumentasi lengkap</span>
            </li>
          </ul>
          <a
            href="#get-started"
            class="block w-full py-3 text-center bg-gray-100 text-gray-700 rounded-full font-semibold hover:bg-gray-200 transition-colors"
          >
            Download Sekarang
          </a>
        </div>

        <!-- Pro Plan -->
        <div
          class="rounded-3xl p-8 bg-gradient-to-br from-purple-600 to-blue-500 text-white relative overflow-hidden shadow-2xl"
        >
          <div
            class="absolute top-0 right-0 bg-yellow-400 text-purple-900 px-4 py-1 text-xs font-bold rounded-bl-lg"
          >
            On Coming
          </div>
          <div class="mb-6">
            <h3 class="text-2xl font-bold mb-2">Pro</h3>
            <p class="text-purple-100">Untuk profesional</p>
          </div>
          <div class="mb-6">
            <span class="text-5xl font-bold">Rp 349K</span>
            <span class="text-purple-100">/bulan</span>
          </div>
          <ul class="space-y-4 mb-8">
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-yellow-300 mt-1"></i>
              <span>40+ Komponen premium</span>
            </li>
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-yellow-300 mt-1"></i>
              <span>Unlimited themes</span>
            </li>
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-yellow-300 mt-1"></i>
              <span>Custom theme builder</span>
            </li>
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-yellow-300 mt-1"></i>
              <span>Priority support</span>
            </li>
            <li class="flex items-start space-x-3">
              <i class="fas fa-check text-yellow-300 mt-1"></i>
              <span>Update selamanya</span>
            </li>
          </ul>
          <button
            disabled
            class="block w-full py-3 text-center bg-white text-purple-600 rounded-full font-semibold hover:shadow-lg transition-all cursor-not-allowed"
          >
            Akan segera datang
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    id="get-started"
    class="py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-purple-600 to-blue-500 text-white relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-black opacity-10"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h2 class="text-4xl lg:text-5xl font-bold mb-6">
        Siap Membuat Artikel Luar Biasa?
      </h2>
      <p class="text-xl text-purple-100 mb-8">
        Bergabunglah dengan ribuan developer yang sudah menggunakan EF Article
        Builder
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="#documentation"
          class="px-8 py-4 bg-white text-purple-600 rounded-full font-semibold hover:shadow-2xl hover:scale-105 transition-all duration-300 flex items-center space-x-2"
        >
          <i class="fas fa-book"></i>
          <span>Baca Dokumentasi</span>
        </a>
        <a
          href="#"
          class="px-8 py-4 bg-purple-800 text-white rounded-full font-semibold hover:bg-purple-900 transition-all duration-300 flex items-center space-x-2"
        >
          <i class="fab fa-github"></i>
          <span>Download di GitHub</span>
        </a>
      </div>
      <div class="mt-12 flex items-center justify-center space-x-8 text-sm">
        <div class="flex items-center space-x-2">
          <i class="fas fa-download text-2xl"></i>
          <div>
            <div class="font-bold text-lg">10K+</div>
            <div class="text-purple-200">Downloads</div>
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <i class="fas fa-star text-2xl"></i>
          <div>
            <div class="font-bold text-lg">4.9/5</div>
            <div class="text-purple-200">Rating</div>
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <i class="fas fa-users text-2xl"></i>
          <div>
            <div class="font-bold text-lg">5K+</div>
            <div class="text-purple-200">Users</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</AppLayout>
