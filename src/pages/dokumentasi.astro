---
import DocumentationLayout from "../layouts/DocumentationLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
---

<DocumentationLayout>
  <main class="flex-1 lg:ml-64 px-4 sm:px-6 lg:px-8 py-8 max-w-5xl">
    <!-- Introduction Section -->
    <section id="introduction" class="mb-16">
      <div
        class="bg-gradient-to-r from-purple-600 to-blue-500 text-white rounded-2xl p-8 mb-8"
      >
        <h1 class="text-4xl font-bold mb-4">Dokumentasi EF Article Builder</h1>
        <p class="text-lg text-purple-100">
          Panduan lengkap untuk menggunakan EF Article Builder dalam proyek Anda
        </p>
        <div class="flex items-center space-x-4 mt-6">
          <span class="bg-white/20 px-4 py-2 rounded-lg text-sm font-semibold"
            >v1.0.0</span
          >
          <span class="bg-white/20 px-4 py-2 rounded-lg text-sm font-semibold"
            >JavaScript</span
          >
          <span class="bg-white/20 px-4 py-2 rounded-lg text-sm font-semibold"
            >MIT License</span
          >
        </div>
      </div>

      <div class="prose max-w-none">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Apa itu EF Article Builder?
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          EF Article Builder adalah JavaScript library modern yang memungkinkan
          Anda membuat builder artikel dengan antarmuka drag-and-drop yang
          intuitif. Library ini dilengkapi dengan berbagai komponen siap pakai
          yang dapat disesuaikan dengan kebutuhan Anda.
        </p>

        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white border border-gray-200 rounded-xl p-6">
            <div
              class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4"
            >
              <i class="fas fa-hand-pointer text-purple-600 text-xl"></i>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Mudah Digunakan</h3>
            <p class="text-sm text-gray-600">
              Interface drag-and-drop yang intuitif tanpa perlu coding
            </p>
          </div>
          <div class="bg-white border border-gray-200 rounded-xl p-6">
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4"
            >
              <i class="fas fa-cubes text-blue-600 text-xl"></i>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">40+ Komponen</h3>
            <p class="text-sm text-gray-600">
              Berbagai komponen dari gratis hingga premium
            </p>
          </div>
          <div class="bg-white border border-gray-200 rounded-xl p-6">
            <div
              class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center mb-4"
            >
              <i class="fas fa-palette text-pink-600 text-xl"></i>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Customizable</h3>
            <p class="text-sm text-gray-600">
              Theme dan konfigurasi yang fleksibel
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Fitur Utama</h2>

      <div
        class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-4"
      >
        <div class="p-6 border-b border-gray-200 bg-gray-50">
          <div class="flex items-center space-x-3">
            <i class="fas fa-check-circle text-green-500 text-xl"></i>
            <h3 class="font-bold text-gray-900">Drag & Drop Interface</h3>
          </div>
        </div>
        <div class="p-6">
          <p class="text-gray-600">
            Susun konten artikel dengan mudah menggunakan sistem drag-and-drop.
            Cukup pilih komponen dari sidebar dan seret ke canvas builder.
          </p>
        </div>
      </div>

      <div
        class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-4"
      >
        <div class="p-6 border-b border-gray-200 bg-gray-50">
          <div class="flex items-center space-x-3">
            <i class="fas fa-check-circle text-green-500 text-xl"></i>
            <h3 class="font-bold text-gray-900">Live Preview</h3>
          </div>
        </div>
        <div class="p-6">
          <p class="text-gray-600">
            Lihat hasil akhir artikel Anda secara real-time saat mengedit. Mode
            live preview menampilkan tampilan final tanpa perlu refresh.
          </p>
        </div>
      </div>

      <div
        class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-4"
      >
        <div class="p-6 border-b border-gray-200 bg-gray-50">
          <div class="flex items-center space-x-3">
            <i class="fas fa-check-circle text-green-500 text-xl"></i>
            <h3 class="font-bold text-gray-900">Multiple Themes</h3>
          </div>
        </div>
        <div class="p-6">
          <p class="text-gray-600 mb-4">
            Pilih dari berbagai tema siap pakai atau buat tema custom Anda
            sendiri:
          </p>
          <ul class="space-y-2">
            <li class="flex items-center space-x-2">
              <span class="w-4 h-4 bg-purple-500 rounded"></span>
              <span class="text-sm text-gray-700">Glassmorphism</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="w-4 h-4 bg-blue-500 rounded"></span>
              <span class="text-sm text-gray-700">Simple Modern</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="w-4 h-4 bg-yellow-500 rounded"></span>
              <span class="text-sm text-gray-700">Colorful</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="w-4 h-4 bg-gray-800 rounded"></span>
              <span class="text-sm text-gray-700">Dark Professional</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="p-6 border-b border-gray-200 bg-gray-50">
          <div class="flex items-center space-x-3">
            <i class="fas fa-check-circle text-green-500 text-xl"></i>
            <h3 class="font-bold text-gray-900">Export & Import</h3>
          </div>
        </div>
        <div class="p-6">
          <p class="text-gray-600">
            Export konten dalam format HTML atau JSON. Support untuk import data
            kembali ke builder untuk editing lebih lanjut.
          </p>
        </div>
      </div>
    </section>

    <!-- Requirements Section -->
    <section id="requirements" class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Persyaratan Sistem</h2>

      <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-6">
        <div class="flex items-start space-x-3">
          <i class="fas fa-info-circle text-blue-600 text-xl mt-1"></i>
          <div>
            <h3 class="font-bold text-blue-900 mb-2">Browser Support</h3>
            <p class="text-blue-800 text-sm">
              EF Article Builder mendukung semua browser modern (Chrome, Firefox,
              Safari, Edge) versi terbaru.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th
                  class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider"
                >
                  Dependency</th
                >
                <th
                  class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider"
                >
                  Versi</th
                >
                <th
                  class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider"
                >
                  Required</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr>
                <td class="px-6 py-4 text-sm text-gray-900">FontAwesome</td>
                <td class="px-6 py-4 text-sm text-gray-600">5.x atau 6.x</td>
                <td class="px-6 py-4"
                  ><span
                    class="px-3 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full"
                    >Ya</span
                  >
                </td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm text-gray-900">Modern Browser</td>
                <td class="px-6 py-4 text-sm text-gray-600">ES6 Support</td>
                <td class="px-6 py-4"
                  ><span
                    class="px-3 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full"
                    >Ya</span
                  >
                </td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm text-gray-900">jQuery</td>
                <td class="px-6 py-4 text-sm text-gray-600">-</td>
                <td class="px-6 py-4"
                  ><span
                    class="px-3 py-1 bg-gray-100 text-gray-800 text-xs font-semibold rounded-full"
                    >Tidak</span
                  >
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Installation Section -->
    <section id="download" class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        Download & Instalasi
      </h2>

      <div
        class="bg-gradient-to-r from-purple-50 to-blue-50 border border-purple-200 rounded-xl p-6 mb-6"
      >
        <h3 class="font-bold text-gray-900 mb-4 text-xl">Download File</h3>
        <p class="text-gray-600 mb-6">
          Download file library dari GitHub atau website resmi:
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          <a
            href="#"
            class="block bg-white border-2 border-purple-300 rounded-xl p-4 hover:shadow-lg transition-all"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-gray-900">Versi Gratis</span>
              <i class="fas fa-download text-purple-600"></i>
            </div>
            <p class="text-sm text-gray-600">15 komponen dasar</p>
          </a>
          <a
            href="#"
            class="block bg-gradient-to-r from-purple-600 to-blue-500 text-white rounded-xl p-4 hover:shadow-lg transition-all"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold">Versi Premium</span>
              <i class="fas fa-crown"></i>
            </div>
            <p class="text-sm text-purple-100">40+ komponen premium</p>
          </a>
        </div>
      </div>

      <h3 id="setup" class="text-2xl font-bold text-gray-900 mb-4">
        Setup Files
      </h3>
      <p class="text-gray-600 mb-4">
        Setelah download, ekstrak file dan masukkan ke dalam project Anda:
      </p>

      <CodeBlock
        lang="Struktur File"
        code={`
        project/
        ├── assets/
        │   ├── css/
        │   │   └── ef-article-builder.css
        │   └── js/
        │       └── ef-article-builder.js
        └── index.html
        `}
      />

      <h3 class="text-2xl font-bold text-gray-900 mb-4">Include Files</h3>
      <p class="text-gray-600 mb-4">
        Tambahkan file CSS dan JS ke dalam HTML Anda:
      </p>

      <CodeBlock
        lang="HTML"
        code={`
        <!-- CSS -->
        <link rel="stylesheet" href="assets/css/ef-article-builder.css">

        <!-- FontAwesome (Required) -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <!-- JavaScript (Before closing body tag) -->
        <script src="assets/js/ef-article-builder.js"></script>`}
      />
    </section>

    <!-- Basic Usage Section -->
    <section id="basic-usage" class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Penggunaan Dasar</h2>

      <h3 class="text-xl font-bold text-gray-900 mb-4">
        1. Buat Container HTML
      </h3>
      <CodeBlock
        lang="HTML"
        code={`
      <div id="my-builder"></div>
      `}
      />

      <h3 class="text-xl font-bold text-gray-900 mb-4">2. Initialize Builder</h3>
      Code
      <CodeBlock
        lang="JavaScript"
        code={`
        const builder = new EfArticleBuilder('#my-builder', {
                        builderTheme: 'glassmorphism',
                        contentTheme: 'glassmorphism',
                        displayMode: 'inline',
                        locale: 'id'
                    });`}
      />
      <div class="bg-green-50 border border-green-200 rounded-xl p-6">
        <div class="flex items-start space-x-3">
          <i class="fas fa-check-circle text-green-600 text-xl mt-1"></i>
          <div>
            <h3 class="font-bold text-green-900 mb-2">Selesai!</h3>
            <p class="text-green-800 text-sm">
              Builder Anda sudah siap digunakan. Pengguna dapat mulai drag
              komponen dan membuat artikel.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Options Section -->
    <section id="options" class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        Configuration Options
      </h2>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th
                  class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider"
                >
                  Option</th
                >
                <th
                  class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider"
                >
                  Type</th
                >
                <th
                  class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider"
                >
                  Default</th
                >
                <th
                  class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase tracking-wider"
                >
                  Deskripsi</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >builderTheme</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">String | Object</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900"
                  >'glassmorphism'</td
                >
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Tema untuk interface builder</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >contentTheme</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">String | Object</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900">null</td>
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Tema untuk output konten</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >displayMode</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">String</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900"
                  >'inline'</td
                >
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Mode tampilan: inline, inline-limited, compact</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >maxHeight</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">String</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900"
                  >'600px'</td
                >
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Tinggi maksimal builder (untuk inline-limited)</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >locale</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">String</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900">'id'</td>
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Bahasa interface (id/en)</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >compactButtonText</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">String</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900"
                  >'Open Builder'</td
                >
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Teks tombol untuk compact mode</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >licenseKey</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">String</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900">null</td>
                <td class="px-6 py-4 text-sm text-gray-600"
                  >License key untuk fitur premium</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >initialContent</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">String | Array</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900">null</td>
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Konten awal (HTML atau JSON)</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >onChange</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">Function</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900">null</td>
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Callback saat konten berubah</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >onReady</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">Function</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900">null</td>
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Callback saat builder siap</td
                >
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-mono text-purple-600"
                  >onSave</td
                >
                <td class="px-6 py-4 text-sm text-gray-600">Function</td>
                <td class="px-6 py-4 text-sm font-mono text-gray-900">null</td>
                <td class="px-6 py-4 text-sm text-gray-600"
                  >Callback saat menyimpan</td
                >
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Themes Section -->
    <section id="themes" class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Themes</h2>

      <p class="text-gray-600 mb-6">
        EF Article Builder menyediakan beberapa tema siap pakai yang dapat Anda
        gunakan:
      </p>

      <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div
            class="h-32 bg-gradient-to-br from-purple-600 to-blue-500 flex items-center justify-center"
          >
            <span class="text-white font-bold text-lg">Glassmorphism</span>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-2">Glassmorphism</h3>
            <p class="text-sm text-gray-600 mb-3">
              Tema dengan efek kaca modern dan gradient yang elegan
            </p>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded text-purple-600"
              >builderTheme: 'glassmorphism'</code
            >
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div
            class="h-32 bg-gray-100 flex items-center justify-center border-b border-gray-300"
          >
            <span class="text-gray-800 font-bold text-lg">Simple Modern</span>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-2">Simple Modern</h3>
            <p class="text-sm text-gray-600 mb-3">
              Tema minimalis dengan warna netral dan clean
            </p>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded text-purple-600"
              >builderTheme: 'simple-modern'</code
            >
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div
            class="h-32 bg-gradient-to-br from-yellow-300 to-orange-400 flex items-center justify-center"
          >
            <span class="text-gray-800 font-bold text-lg">Colorful</span>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-2">Colorful</h3>
            <p class="text-sm text-gray-600 mb-3">
              Tema penuh warna dengan gradient cerah
            </p>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded text-purple-600"
              >builderTheme: 'colorful'</code
            >
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div class="h-32 bg-gray-900 flex items-center justify-center">
            <span class="text-white font-bold text-lg">Dark Professional</span>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-2">Dark Professional</h3>
            <p class="text-sm text-gray-600 mb-3">
              Tema gelap profesional untuk mode malam
            </p>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded text-purple-600"
              >builderTheme: 'dark-professional'</code
            >
          </div>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-900 mb-4">Custom Theme</h3>
      <p class="text-gray-600 mb-4">
        Anda juga dapat membuat tema custom dengan mendefinisikan CSS variables:
      </p>

      <CodeBlock
        lang="JavaScript"
        code={`
        const builder = new EfArticleBuilder('#my-builder', {
            builderTheme: {
                '--ef-bg': '#ffffff',
                '--ef-card-bg': '#f8f9fa',
                '--ef-text-primary': '#212529',
                '--ef-text-secondary': '#6c757d'
            },
            contentTheme: 'simple-modern'
        });
      `}
      />
    </section>

    <!-- Display Modes Section -->
    <section id="display-modes" class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Display Modes</h2>

      <div class="space-y-6">
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div
            class="p-6 border-b border-gray-200 bg-gradient-to-r from-purple-50 to-blue-50"
          >
            <h3 class="font-bold text-gray-900 text-lg mb-2">Inline Mode</h3>
            <code class="text-sm bg-white px-3 py-1 rounded text-purple-600"
              >displayMode: 'inline'</code
            >
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-4">
