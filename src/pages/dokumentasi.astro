                  >
                </div>
                <pre
                  class="p-4 overflow-x-auto"><code class="text-sm text-gray-300">// Export sebagai JSON
const jsonData = builder.export('json');

// Export sebagai HTML
const htmlData = builder.export('html');</code></pre>
              </div>
            </div>
          </div>
        </div>

        <!-- import() -->
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div class="p-4 bg-gray-50 border-b border-gray-200">
            <code class="text-lg font-mono text-purple-600"
              >builder.import(data)</code
            >
