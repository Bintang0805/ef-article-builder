            <div>
              <h4 class="font-bold text-sm text-gray-700 mb-2">Contoh:</h4>
              <CodeBlock
                lang="JavaScript"
                code={`
                // Import dari JSON string
                const jsonData = '{"content":[...]}';
                builder.import(jsonData);

                // Import dari HTML string
                const htmlData = '&lt;div class="ef-preview-container"&gt;...&lt;/div&gt;';
                builder.import(htmlData);

                // Import dari Array
                const arrayData = [{tag: 'h2', text: 'Hello'}];
                builder.import(arrayData);
              `}
              />
            </div>
          </div>
        </div>

